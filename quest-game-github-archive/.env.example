# Скопируйте: cp .env.example .env
# Dashboard: https://supabase.com/dashboard/project/tvytsnnujaucoluoyvjq

# --- API Keys (Settings → API Keys) ---
VITE_SUPABASE_URL=https://tvytsnnujaucoluoyvjq.supabase.co
VITE_SUPABASE_ANON_KEY=

# Публичный URL для QR / регистрации с телефона (LAN IP dev-сервера, не localhost).
# Если открываете админку с того же IP, что и телефоны — порт должен совпадать с npm run dev (5173),
# либо оставьте пустым: на LAN возьмётся origin текущей вкладки.
# Пример: http://192.168.1.10:5173
VITE_PUBLIC_URL=

# Secret key — только для node-скриптов, не VITE_
SUPABASE_SERVICE_ROLE_KEY=

# --- Postgres (Connect → Connection string) ---
SUPABASE_DB_PASSWORD=
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.tvytsnnujaucoluoyvjq.supabase.co:5432/postgres
# При ENOTFOUND / IPv4 — Connect → Pooler settings → Session:
DATABASE_URL_SESSION_POOLER=postgresql://postgres.tvytsnnujaucoluoyvjq:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- AI (секреты Edge, не VITE_) — IMP-PRD-002 ---
# Задаются в Supabase Dashboard → Edge Functions → Secrets (НЕ в .env и НЕ в чат)
# supabase secrets set GROQ_API_KEY=gsk_...     # Groq, бесплатный tier (рекомендуется)
# supabase secrets set DASHSCOPE_API_KEY=...   # Qwen (DashScope)
# supabase secrets set DEEPSEEK_API_KEY=...    # DeepSeek
